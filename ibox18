                    </div>

                    <div>
                      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">Mobile Number *</label>
                      <input name="mobile" type="tel" required pattern="[0-9]{10}" maxlength="10" value="${UI.escapeHTML(profile.mobile || '')}" placeholder="10-digit mobile number" class="w-full px-4 py-3 rounded-xl bg-obsidian border border-white/15 text-sm text-white focus:outline-none focus:border-fire" />
                    </div>

                    <div>
                      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">WhatsApp Number *</label>
                      <input name="whatsapp" type="tel" required pattern="[0-9]{10}" maxlength="10" value="${UI.escapeHTML(profile.whatsapp || profile.mobile || '')}" placeholder="10-digit WhatsApp number" class="w-full px-4 py-3 rounded-xl bg-obsidian border border-white/15 text-sm text-white focus:outline-none focus:border-fire" />
                    </div>

                    <div class="sm:col-span-2">
                      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">Complete Street Address *</label>
                      <textarea name="address" rows="2" required placeholder="House/Flat No., Building, Street, Landmark" class="w-full px-4 py-3 rounded-xl bg-obsidian border border-white/15 text-sm text-white focus:outline-none focus:border-fire">${UI.escapeHTML(profile.address || '')}</textarea>
                    </div>

                    <div>
                      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">City *</label>
                      <input name="city" type="text" required value="${UI.escapeHTML(profile.city || '')}" placeholder="City" class="w-full px-4 py-3 rounded-xl bg-obsidian border border-white/15 text-sm text-white focus:outline-none focus:border-fire" />
                    </div>

                    <div>
                      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">District *</label>
                      <input name="district" type="text" required value="${UI.escapeHTML(profile.district || '')}" placeholder="District" class="w-full px-4 py-3 rounded-xl bg-obsidian border border-white/15 text-sm text-white focus:outline-none focus:border-fire" />
                    </div>

                    <div class="sm:col-span-2">
                      <label class="block text-xs font-bold uppercase tracking-wider text-muted mb-1.5">Pincode *</label>
                      <input name="pincode" type="text" required pattern="[0-9]{6}" maxlength="6" value="${UI.escapeHTML(profile.pincode || '')}" placeholder="6-digit Pincode" class="w-full px-4 py-3 rounded-xl bg-obsidian border border-white/15 text-sm text-white focus:outline-none focus:border-fire" />
                    </div>
                  </div>
                </div>

