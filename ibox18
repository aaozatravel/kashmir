                  <span class="text-fire font-extrabold">${UI.formatCurrency(maxPrice)}</span>
                </div>
                <input type="range" min="1000" max="15000" step="500" value="${maxPrice}" oninput="App.setCategoryFilter('maxPrice', this.value)" class="w-full accent-[#FF2727] cursor-pointer" />
              </div>

              <!-- Sort by Price -->
              <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-muted mb-1">Sort By</label>
                <select onchange="App.setCategoryFilter('sort', this.value)" class="w-full px-3.5 py-2.5 rounded-xl bg-obsidian border border-white/10 text-xs text-white focus:outline-none focus:border-fire">
                  <option value="featured" ${sort === 'featured' ? 'selected' : ''}>Featured Drops</option>
                  <option value="price-asc" ${sort === 'price-asc' ? 'selected' : ''}>Price: Low to High</option>
                  <option value="price-desc" ${sort === 'price-desc' ? 'selected' : ''}>Price: High to Low</option>
                </select>
              </div>
            </div>

            <!-- Results Count & Reset -->
            <div class="flex items-center justify-between mb-4 text-xs text-muted">
              <span>Showing <strong class="text-white">${filtered.length}</strong> men's pieces</span>
              ${
                category !== 'All' || search || size !== 'All' || Number(maxPrice) < 15000
                  ? `<button onclick="App.resetCategoryFilters()" class="text-fire font-bold hover:underline">Reset Filters</button>`
                  : ''
              }
            </div>

            <!-- Product Grid (2 Col Mobile, 3-4 Col Desktop) -->
            ${
              filtered.length === 0
                ? `
              <div class="bg-cardbg border border-white/10 rounded-3xl p-12 text-center my-6">
                <h3 class="font-display font-bold text-xl text-white">No Products Match Your Filters</h3>
                <p class="text-xs text-muted mt-2">Adjust your price ceiling, size, or category selection.</p>
                <button onclick="App.resetCategoryFilters()" class="mt-5 px-6 py-3 rounded-xl fire-gradient-hover text-xs font-extrabold uppercase tracking-wider text-white">
                  Show All Menswear
                </button>
              </div>
            `
                : `
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-5">
                ${filtered.map(p => this.renderProductCard(p)).join('')}
              </div>
            `
            }
          </div>
        `;
      },

      setCategoryFilter(key, value) {
        this.state.catFilters[key] = value;
        this.renderView();
      },

      resetCategoryFilters() {
        this.state.catFilters = {
          category: 'All',
          search: '',
          maxPrice: 15000,
          size: 'All',
          sort: 'featured'
        };
        this.renderView();
      },

      // ------------------------------------------------------------------------
      // VIEW 3: PRODUCT DETAILS PAGE (PDP)
      // ------------------------------------------------------------------------
      renderProductDetailView() {
        const productId = this.state.params.productId;
        const product = this.getProducts().find(p => p.id === productId);

        if (!product) {
          return `
            <div class="max-w-xl mx-auto px-4 py-20 text-center">
              <h2 class="font-display font-bold text-2xl text-white">Piece Not Found</h2>
              <button onclick="App.navigate('category', { category: 'All' })" class="mt-4 px-6 py-3 rounded-xl fire-gradient text-xs font-bold uppercase">Back to Collection</button>
            </div>
          `;
        }

        const images = product.images && product.images.length ? product.images : [UI.fallbackImg(product.name)];
        const activeImg = images[this.state.pdpActiveImageIdx] || images[0];
        const discount = UI.calcDiscount(product.price, product.originalPrice);
        const isWished = this.getWishlist().includes(product.id);
        const outOfStock = !product.available || Number(product.stock) <= 0;

        const related = this.getActiveProducts()
          .filter(p => p.id !== product.id && p.category === product.category)
          .slice(0, 4);
        const fallbackRelated = related.length
          ? related
          : this.getActiveProducts().filter(p => p.id !== product.id).slice(0, 4);

        return `
          <div class="view-animate max-w-7xl mx-auto px-4 sm:px-6 pt-5 pb-14">
