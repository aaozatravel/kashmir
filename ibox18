  <script>
    /**
     * i.Box18 — Complete Client-Side E-Commerce Engine
     * Pure Vanilla JS + LocalStorage Database Persistence
     */

    // --------------------------------------------------------------------------
    // 1. LOCALSTORAGE KEYS & SAFE PERSISTENCE LAYER
    // --------------------------------------------------------------------------
    const STORAGE_KEYS = {
      PRODUCTS: 'ibox18_products',
      CART: 'ibox18_cart',
      ORDERS: 'ibox18_orders',
      USERS: 'ibox18_users',
      PROFILE: 'ibox18_profile',
