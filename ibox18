      submitOrder(event) {
        event.preventDefault();
        const form = event.target;
        const formData = new FormData(form);
        const cart = this.getCart();
        if (cart.length === 0) return;

        const totals = this.getCartTotals();
        const orderId = 'IBX-' + Date.now().toString().slice(-6) + Math.floor(10 + Math.random() * 89);

        const customer = {
          fullName: formData.get('fullName').trim(),
          mobile: formData.get('mobile').trim(),
          whatsapp: formData.get('whatsapp').trim(),
          address: formData.get('address').trim(),
          city: formData.get('city').trim(),
          district: formData.get('district').trim(),
          pincode: formData.get('pincode').trim(),
        };

        const newOrder = {
          orderId,
          date: new Date().toLocaleString('en-IN', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          }),
          items: cart,
          subtotal: totals.subtotal,
          delivery: totals.delivery,
          totalAmount: totals.total,
          paymentMethod: formData.get('paymentMethod') || 'COD',
          status: 'Pending',
          customer
        };

        // Save order history
        const orders = this.getOrders();
        orders.unshift(newOrder);
        Store.set(STORAGE_KEYS.ORDERS, orders);

        // Save/update local customer profile & users list
        Store.set(STORAGE_KEYS.PROFILE, customer);
        const users = Store.get(STORAGE_KEYS.USERS, []);
        if (!users.some(u => u.mobile === customer.mobile)) {
          users.push({ ...customer, createdAt: new Date().toISOString() });
          Store.set(STORAGE_KEYS.USERS, users);
        }

        // Decrement stock in products catalog
        const products = this.getProducts().map(prod => {
          const orderedQty = cart
            .filter(c => c.productId === prod.id)
            .reduce((sum, c) => sum + c.quantity, 0);
          if (orderedQty > 0) {
            return { ...prod, stock: Math.max(0, Number(prod.stock) - orderedQty) };
          }
          return prod;
        });
        Store.set(STORAGE_KEYS.PRODUCTS, products);

        // Clear purchased cart items
        Store.set(STORAGE_KEYS.CART, []);
        this.updateCartBadges(true);

        this.navigate('order-success', { orderId });
      },

