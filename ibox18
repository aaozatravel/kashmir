            <div class="flex items-center gap-2 text-xs text-muted mb-5">
              <button onclick="App.navigate('home')" class="hover:text-white">Home</button>
              <span>/</span>
              <button onclick="App.navigate('category', { category: '${UI.escapeHTML(product.category)}' })" class="hover:text-white">${UI.escapeHTML(product.category)}</button>
              <span>/</span>
              <span class="text-white truncate">${UI.escapeHTML(product.name)}</span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
              <!-- Left: Image Gallery -->
              <div class="lg:col-span-6 space-y-3">
                <div class="relative aspect-[4/5] rounded-3xl overflow-hidden bg-cardbg border border-white/10">
