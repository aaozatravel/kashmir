                    product.badge
                      ? `<span class="absolute top-4 left-4 px-3 py-1 rounded-lg fire-gradient text-xs font-extrabold uppercase tracking-wider text-white shadow-fire-glow">${UI.escapeHTML(product.badge)}</span>`
                      : ''
