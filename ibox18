      // ------------------------------------------------------------------------
      // SPA ROUTER & NAVIGATION STATE
      // ------------------------------------------------------------------------
      navigate(view, params = {}) {
        this.state.currentView = view;
        this.state.params = params;

        // Sync category filter if navigating to category
        if (view === 'category' && params.category) {
          this.state.catFilters.category = params.category;
        }

        // Reset PDP state when opening a product
        if (view === 'product' && params.productId) {
          const prod = this.getProducts().find(p => p.id === params.productId);
          this.state.pdpSelectedSize = null; // Force explicit size selection as required
          this.state.pdpSelectedColor = prod && prod.colors && prod.colors.length ? prod.colors[0] : 'Standard';
          this.state.pdpQuantity = 1;
          this.state.pdpActiveImageIdx = 0;
        }

        this.updateActiveNavIndicators(view);
        window.scrollTo({ top: 0, behavior: 'smooth' });
        this.renderView();
      },

      updateActiveNavIndicators(view) {
        // Bottom Nav
        document.querySelectorAll('[data-bottom-nav]').forEach(btn => {
          const target = btn.getAttribute('data-bottom-nav');
          const isMatch =
            target === view ||
            (view === 'product' && target === 'category') ||
            (view === 'checkout' && target === 'cart') ||
            (view === 'order-success' && target === 'orders');
          btn.classList.toggle('active', isMatch);
        });

        // Desktop Top Nav
        document.querySelectorAll('[data-top-nav]').forEach(btn => {
          const target = btn.getAttribute('data-top-nav');
          btn.classList.toggle('text-fire', target === view);
        });
      },

      renderView() {
        const main = document.getElementById('app-main');
        if (!main) return;

        switch (this.state.currentView) {
          case 'home':
            main.innerHTML = this.renderHomeView();
            break;
          case 'category':
            main.innerHTML = this.renderCategoryView();
            break;
          case 'product':
            main.innerHTML = this.renderProductDetailView();
            break;
          case 'cart':
            main.innerHTML = this.renderCartView();
            break;
          case 'checkout':
            main.innerHTML = this.renderCheckoutView();
            break;
          case 'order-success':
            main.innerHTML = this.renderOrderSuccessView();
            break;
          case 'orders':
            main.innerHTML = this.renderOrdersView();
            break;
          case 'account':
            main.innerHTML = this.renderAccountView();
            break;
          case 'admin':
            if (!this.state.adminUnlocked) {
              this.navigate('home');
              this.openAdminLogin();
              return;
            }
            main.innerHTML = this.renderAdminView();
            break;
          default:
            main.innerHTML = this.renderHomeView();
        }
