  <style>
    /* ==========================================================================
       i.Box18 — DARK LUXURY + ROCK + FIRE CUSTOM STYLES
       ========================================================================== */
    :root {
      --bg-primary: #080808;
      --bg-secondary: #111111;
      --bg-card: #171717;
      --text-primary: #FFFFFF;
      --text-secondary: #999999;
      --accent-fire: #FF2727;
      --accent-orange: #FF6B00;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #080808;
    }
    ::-webkit-scrollbar-thumb {
      background: #2b2b2b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #FF2727;
    }

    /* Hide scrollbar utility */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Fire Gradients & Typography */
    .fire-gradient {
      background: linear-gradient(135deg, #FF2727 0%, #FF6B00 100%);
    }
    .fire-gradient-hover {
      background: linear-gradient(135deg, #FF2727 0%, #FF6B00 100%);
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }
    .fire-gradient-hover:hover {
      box-shadow: 0 0 28px rgba(255, 39, 39, 0.6), 0 0 12px rgba(255, 107, 0, 0.4);
      transform: translateY(-1px);
    }
    .fire-text-gradient {
      background: linear-gradient(135deg, #FFFFFF 15%, #FF6B00 65%, #FF2727 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .fire-border-glow {
      border: 1px solid rgba(255, 39, 39, 0.35);
      box-shadow: inset 0 0 20px rgba(255, 39, 39, 0.08);
    }

    /* Glassmorphism */
    .glass-dark {
      background: rgba(14, 14, 14, 0.82);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }
    .glass-bottom-nav {
      background: rgba(12, 12, 12, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Ambient Ember Canvas */
    #ember-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      opacity: 0.45;
    }

    /* View Transitions */
    .view-animate {
      animation: fadeSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes fadeSlideUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Shake validation animation */
    @keyframes shakeX {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .shake-anim {
      animation: shakeX 0.35s ease-in-out;
    }

    /* Cart Badge Pop */
    @keyframes badgePop {
      0% { transform: scale(1); }
      45% { transform: scale(1.38); }
      100% { transform: scale(1); }
    }
    .badge-pop {
      animation: badgePop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Product Card Hover */
    .product-card {
      background: #171717;
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .product-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 39, 39, 0.45);
      box-shadow: 0 14px 34px -10px rgba(255, 39, 39, 0.22);
    }
    .product-card img {
      transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .product-card:hover img {
      transform: scale(1.06);
    }

    /* Skeleton Shimmer */
    .skeleton {
      background: linear-gradient(90deg, #151515 25%, #222222 50%, #151515 75%);
      background-size: 200% 100%;
      animation: shimmer 1.4s infinite;
    }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Bottom Nav Active Indicator */
    .nav-btn.active {
      color: #FFFFFF;
    }
    .nav-btn.active .nav-icon-wrap {
      color: #FF2727;
      filter: drop-shadow(0 0 10px rgba(255, 39, 39, 0.85));
    }
    .nav-btn.active::after {
      content: '';
      position: absolute;
      top: 0;
      width: 28px;
      height: 3px;
      border-radius: 0 0 6px 6px;
      background: linear-gradient(90deg, #FF2727, #FF6B00);
      box-shadow: 0 2px 12px #FF2727;
    }
  </style>
</head>
