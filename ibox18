        }
        return products
          .map(
            p => `
          <div class="bg-obsidian border border-white/10 rounded-2xl p-3.5 flex items-center gap-3.5">
            <img src="${UI.escapeHTML(p.images?.[0] || '')}" onerror="this.src='${UI.fallbackImg(p.name)}'" class="w-14 h-16 rounded-xl object-cover bg-cardbg shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-extrabold uppercase text-fire">${UI.escapeHTML(p.category)}</span>
                <span class="text-[10px] px-2 py-0.5 rounded ${p.available !== false ? 'bg-emerald-500/15 text-emerald-400' : 'bg-neutral-800 text-muted'}">
                  ${p.available !== false ? `In Stock (${p.stock})` : 'Hidden'}
                </span>
              </div>
              <h4 class="text-xs sm:text-sm font-bold text-white truncate mt-0.5">${UI.escapeHTML(p.name)}</h4>
              <p class="text-xs font-extrabold text-white mt-0.5">${UI.formatCurrency(p.price)}</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-1.5 shrink-0">
              <button onclick="App.toggleAdminProductAvailability('${p.id}')" class="px-2.5 py-1.5 rounded-lg bg-cardbg border border-white/10 text-[10px] font-bold text-white hover:border-ember">
                ${p.available !== false ? 'Hide' : 'Show'}
              </button>
              <button onclick="App.editAdminProduct('${p.id}')" class="px-2.5 py-1.5 rounded-lg bg-cardbg border border-white/10 text-[10px] font-bold text-white hover:border-fire">
                Edit
              </button>
              <button onclick="App.deleteAdminProduct('${p.id}')" class="px-2.5 py-1.5 rounded-lg bg-fire/15 text-fire text-[10px] font-bold hover:bg-fire hover:text-white">
                Del
              </button>
            </div>
          </div>
        `
          )
          .join('');
      },

      setAdminTab(tab) {
        this.state.adminTab = tab;
        this.renderView();
      },

      lockAdmin() {
        this.state.adminUnlocked = false;
        if (window.location.hash === '#admin') {
          history.replaceState(null, '', window.location.pathname);
        }
        UI.toast('Admin Vault locked.', 'warning');
        this.navigate('home');
      },

      filterAdminProducts(query) {
        const q = (query || '').trim().toLowerCase();
        const filtered = this.getProducts().filter(
          p => p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q)
        );
        const container = document.getElementById('admin-products-list');
        if (container) container.innerHTML = this.renderAdminProductsList(filtered);
      },

      handleAdminImageUpload(event, targetInputId, appendMode) {
        const file = event.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUrl = e.target.result;
          const input = document.getElementById(targetInputId);
          if (input) {
            if (appendMode && input.value.trim()) {
              input.value = input.value.trim() + ', ' + dataUrl;
            } else {
              input.value = dataUrl;
            }
            UI.toast('Image attached!', 'success');
          }
        };
        reader.readAsDataURL(file);
      },

      saveAdminProduct(event) {
        event.preventDefault();
        const fd = new FormData(event.target);
        const products = this.getProducts();

        const images = fd
          .get('images')
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

        const sizes = fd
          .get('sizes')
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

        const colors = fd
          .get('colors')
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

        const payload = {
          name: fd.get('name').trim(),
          category: fd.get('category'),
          badge: fd.get('badge'),
          price: Number(fd.get('price')),
          originalPrice: Number(fd.get('originalPrice')) || 0,
          stock: Number(fd.get('stock')) || 0,
          description: fd.get('description').trim(),
          images: images.length ? images : [UI.fallbackImg(fd.get('name'))],
          sizes: sizes.length ? sizes : ['M', 'L', 'XL'],
          colors: colors.length ? colors : ['Obsidian Black'],
          available: true
        };

        if (this.state.editingProductId) {
          const idx = products.findIndex(p => p.id === this.state.editingProductId);
          if (idx > -1) {
            products[idx] = { ...products[idx], ...payload };
            UI.toast('Product updated.', 'success');
          }
          this.state.editingProductId = null;
        } else {
          products.unshift({
            id: 'IBX-PRD-' + Date.now().toString().slice(-5),
            ...payload
          });
          UI.toast('New menswear product published!', 'success');
        }

        Store.set(STORAGE_KEYS.PRODUCTS, products);
        this.renderView();
      },

      editAdminProduct(productId) {
        this.state.editingProductId = productId;
        this.renderView();
      },

      cancelAdminEditProduct() {
        this.state.editingProductId = null;
        this.renderView();
      },

      toggleAdminProductAvailability(productId) {
        const products = this.getProducts().map(p =>
          p.id === productId ? { ...p, available: p.available === false ? true : false } : p
        );
        Store.set(STORAGE_KEYS.PRODUCTS, products);
        this.renderView();
      },

      deleteAdminProduct(productId) {
        const products = this.getProducts().filter(p => p.id !== productId);
        Store.set(STORAGE_KEYS.PRODUCTS, products);
        if (this.state.editingProductId === productId) this.state.editingProductId = null;
        UI.toast('Product deleted.', 'warning');
        this.renderView();
      },

      saveAdminBanner(event) {
        event.preventDefault();
        const fd = new FormData(event.target);
        const banners = this.getBanners();

        const payload = {
          heading: fd.get('heading').trim(),
          subtitle: fd.get('subtitle').trim(),
          buttonText: fd.get('buttonText').trim() || 'EXPLORE NOW',
          destinationCategory: fd.get('destinationCategory') || 'All',
          image: fd.get('image').trim(),
          enabled: true
        };

        if (this.state.editingBannerId) {
          const idx = banners.findIndex(b => b.id === this.state.editingBannerId);
          if (idx > -1) {
            banners[idx] = { ...banners[idx], ...payload };
            UI.toast('Banner updated.', 'success');
          }
          this.state.editingBannerId = null;
        } else {
          banners.push({
            id: 'BNR-' + Date.now().toString().slice(-4),
            ...payload
          });
          UI.toast('Promotional banner added!', 'success');
        }

        Store.set(STORAGE_KEYS.BANNERS, banners);
        this.renderView();
      },

      editAdminBanner(bannerId) {
        this.state.editingBannerId = bannerId;
        this.renderView();
      },

      cancelAdminEditBanner() {
        this.state.editingBannerId = null;
        this.renderView();
      },

      toggleAdminBanner(bannerId) {
        const banners = this.getBanners().map(b =>
          b.id === bannerId ? { ...b, enabled: !b.enabled } : b
        );
        Store.set(STORAGE_KEYS.BANNERS, banners);
        this.renderView();
      },

      deleteAdminBanner(bannerId) {
        const banners = this.getBanners().filter(b => b.id !== bannerId);
        Store.set(STORAGE_KEYS.BANNERS, banners);
        if (this.state.editingBannerId === bannerId) this.state.editingBannerId = null;
        UI.toast('Banner removed.', 'warning');
        this.renderView();
      },

      updateAdminOrderStatus(orderId, newStatus) {
        const orders = this.getOrders().map(o =>
          o.orderId === orderId ? { ...o, status: newStatus } : o
        );
        Store.set(STORAGE_KEYS.ORDERS, orders);
        UI.toast(`Order ${orderId} set to ${newStatus}.`, 'success');
      },

      saveAdminSettingsForm(event) {
        event.preventDefault();
        const fd = new FormData(event.target);
        const current = this.getAdminSettings();
        Store.set(STORAGE_KEYS.ADMIN_SETTINGS, {
          ...current,
          password: fd.get('password').trim() || 'ibox18admin',
          freeShippingThreshold: Number(fd.get('freeShippingThreshold')) || 1999,
          standardShippingFee: Number(fd.get('standardShippingFee')) || 99
        });
        UI.toast('Admin vault settings saved.', 'success');
      },

      restoreDemoCatalog() {
        Store.set(STORAGE_KEYS.PRODUCTS, SEED_PRODUCTS);
        Store.set(STORAGE_KEYS.BANNERS, SEED_BANNERS);
        UI.toast('Default catalog & banners restored.', 'success');
        this.renderView();
      },

      // ------------------------------------------------------------------------
      // AMBIENT FIRE EMBER PARTICLE SYSTEM (Lightweight Canvas)
      // ------------------------------------------------------------------------
      initEmberParticles() {
        const canvas = document.getElementById('ember-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        });

        const emberCount = window.innerWidth < 640 ? 18 : 34;
        const embers = Array.from({ length: emberCount }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 1.8 + 0.6,
          vy: -(Math.random() * 0.45 + 0.15),
          vx: (Math.random() - 0.5) * 0.3,
          alpha: Math.random() * 0.6 + 0.2,
          color: Math.random() > 0.45 ? '#FF2727' : '#FF6B00'
        }));

        function loop() {
          ctx.clearRect(0, 0, width, height);
          for (const e of embers) {
            e.x += e.vx;
            e.y += e.vy;
            if (e.y < -10) {
              e.y = height + 10;
              e.x = Math.random() * width;
            }
            if (e.x < 0) e.x = width;
            if (e.x > width) e.x = 0;

            ctx.beginPath();
            ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);
            ctx.fillStyle = e.color;
            ctx.globalAlpha = e.alpha;
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          requestAnimationFrame(loop);
        }
        loop();
      }
    };

    // Boot application when DOM is ready
    window.addEventListener('DOMContentLoaded', () => App.init());
  </script>
