                    <svg class="w-5 h-5 ${isWished ? 'text-fire fill-fire' : 'text-white'}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                </div>

                ${
                  images.length > 1
                    ? `
                  <div class="flex gap-3 overflow-x-auto pb-1">
                    ${images
                      .map(
                        (img, idx) => `
                      <button onclick="App.setPdpImage(${idx})" class="w-20 h-24 rounded-xl overflow-hidden border-2 transition-all shrink-0 ${
                        this.state.pdpActiveImageIdx === idx ? 'border-fire shadow-fire-glow' : 'border-white/10 opacity-60 hover:opacity-100'
                      }">
                        <img src="${UI.escapeHTML(img)}" onerror="this.src='${UI.fallbackImg(product.name)}'" class="w-full h-full object-cover" />
                      </button>
                    `
                      )
                      .join('')}
                  </div>
                `
                    : ''
                }
              </div>

              <!-- Right: Product Info & Purchase Controls -->
              <div class="lg:col-span-6 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2.5">
                    <span class="text-xs font-extrabold uppercase tracking-[0.22em] text-fire">${UI.escapeHTML(product.category)}</span>
                    <span class="text-muted">•</span>
                    <span class="text-xs font-semibold ${outOfStock ? 'text-fire' : 'text-emerald-400'}">
                      ${outOfStock ? 'Out of Stock' : `In Stock (${product.stock} left)`}
                    </span>
                  </div>

                  <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white mt-2 leading-tight">
                    ${UI.escapeHTML(product.name)}
                  </h1>

                  <!-- Pricing -->
                  <div class="flex items-baseline gap-3 mt-4 pb-5 border-b border-white/10">
                    <span class="font-display font-extrabold text-3xl text-white">${UI.formatCurrency(product.price)}</span>
                    ${
                      product.originalPrice > product.price
                        ? `<span class="text-base text-muted line-through">${UI.formatCurrency(product.originalPrice)}</span>`
                        : ''
                    }
                    ${
                      discount > 0
                        ? `<span class="px-2.5 py-1 rounded-md bg-fire/20 border border-fire/40 text-xs font-extrabold text-fire">SAVE ${discount}%</span>`
                        : ''
                    }
                  </div>

                  <!-- Description -->
                  <p class="text-sm text-neutral-300 leading-relaxed mt-5">
                    ${UI.escapeHTML(product.description)}
                  </p>

                  <!-- Color Selection -->
                  ${
                    product.colors && product.colors.length
                      ? `
                    <div class="mt-6">
                      <span class="block text-xs font-bold uppercase tracking-wider text-muted mb-2.5">
                        Colorway: <strong class="text-white">${UI.escapeHTML(this.state.pdpSelectedColor)}</strong>
                      </span>
                      <div class="flex flex-wrap gap-2.5">
                        ${product.colors
                          .map(
                            col => `
                          <button type="button" onclick="App.selectPdpColor('${UI.escapeHTML(col)}')" class="px-4 py-2 rounded-xl text-xs font-bold border transition-all ${
                            this.state.pdpSelectedColor === col
                              ? 'border-fire bg-fire/15 text-white shadow-fire-glow'
                              : 'border-white/10 bg-cardbg text-muted hover:text-white'
                          }">
                            ${UI.escapeHTML(col)}
                          </button>
                        `
                          )
                          .join('')}
                      </div>
                    </div>
                  `
                      : ''
                  }

                  <!-- Mandatory Size Selection -->
                  <div id="pdp-size-selector" class="mt-6 p-3.5 rounded-2xl bg-charcoal border border-white/10 transition-colors">
                    <div class="flex items-center justify-between mb-2.5">
                      <span class="text-xs font-bold uppercase tracking-wider text-muted">
                        Select Size <span class="text-fire">*</span>
                      </span>
                      <span class="text-xs font-bold text-white">
                        ${this.state.pdpSelectedSize ? `Selected: ${UI.escapeHTML(this.state.pdpSelectedSize)}` : 'Required'}
                      </span>
                    </div>
                    <div class="grid grid-cols-4 sm:grid-cols-5 gap-2">
                      ${(product.sizes || [])
                        .map(
                          sz => `
                        <button type="button" onclick="App.selectPdpSize('${UI.escapeHTML(sz)}')" class="py-2.5 rounded-xl text-xs font-extrabold uppercase border transition-all ${
                          this.state.pdpSelectedSize === sz
                            ? 'fire-gradient border-transparent text-white shadow-fire-glow'
                            : 'bg-obsidian border-white/10 text-white hover:border-fire/60'
                        }">
                          ${UI.escapeHTML(sz)}
                        </button>
                      `
                        )
                        .join('')}
                    </div>
                  </div>

                  <!-- Quantity Selector -->
                  <div class="mt-6 flex items-center gap-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-muted">Quantity</span>
                    <div class="inline-flex items-center bg-cardbg border border-white/10 rounded-xl overflow-hidden">
                      <button type="button" onclick="App.changePdpQty(-1)" class="w-10 h-10 flex items-center justify-center text-white hover:bg-white/10 font-bold">−</button>
                      <span class="w-10 text-center text-sm font-extrabold">${this.state.pdpQuantity}</span>
                      <button type="button" onclick="App.changePdpQty(1)" class="w-10 h-10 flex items-center justify-center text-white hover:bg-white/10 font-bold">+</button>
                    </div>
                  </div>
                </div>

                <!-- CTA Buttons: Add to Cart & Buy Now -->
                <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                  <button type="button" ${outOfStock ? 'disabled' : ''} onclick="App.handlePdpAdd('${product.id}', false)" class="py-4 px-6 rounded-xl bg-cardbg hover:bg-neutral-800 border border-fire/50 font-display font-extrabold text-xs sm:text-sm uppercase tracking-wider text-white transition-all disabled:opacity-40">
                    Add to Bag
                  </button>
                  <button type="button" ${outOfStock ? 'disabled' : ''} onclick="App.handlePdpAdd('${product.id}', true)" class="py-4 px-6 rounded-xl fire-gradient-hover font-display font-extrabold text-xs sm:text-sm uppercase tracking-wider text-white shadow-fire-glow disabled:opacity-40">
                    Buy Now
                  </button>
                </div>
              </div>
            </div>

            <!-- Related Products -->
            ${
              fallbackRelated.length
                ? `
              <section class="mt-16 pt-10 border-t border-white/10">
                <span class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-fire">Complete The Fit</span>
                <h2 class="font-display font-extrabold text-2xl text-white mt-1 mb-6">RELATED PIECES</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-5">
                  ${fallbackRelated.map(p => this.renderProductCard(p)).join('')}
                </div>
              </section>
            `
                : ''
            }
          </div>
        `;
      },

      setPdpImage(idx) {
        this.state.pdpActiveImageIdx = idx;
        this.renderView();
      },
      selectPdpSize(size) {
        this.state.pdpSelectedSize = size;
        this.renderView();
      },
      selectPdpColor(color) {
        this.state.pdpSelectedColor = color;
        this.renderView();
      },
      changePdpQty(delta) {
        this.state.pdpQuantity = Math.max(1, Math.min(10, this.state.pdpQuantity + delta));
        this.renderView();
      },
      handlePdpAdd(productId, buyNow) {
        this.addToCart(
          productId,
          this.state.pdpSelectedSize,
          this.state.pdpSelectedColor,
          this.state.pdpQuantity,
          buyNow
        );
      },

      // ------------------------------------------------------------------------
      // VIEW 4: SHOPPING CART PAGE
      // ------------------------------------------------------------------------
      renderCartView() {
        const cart = this.getCart();
        const totals = this.getCartTotals();

        return `
          <div class="view-animate max-w-5xl mx-auto px-4 sm:px-6 pt-6 pb-14">
            <div class="flex items-center justify-between mb-6">
              <div>
                <span class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-fire">Your Arsenal</span>
                <h1 class="font-display font-extrabold text-2xl sm:text-4xl text-white mt-0.5">SHOPPING BAG</h1>
              </div>
              <span class="px-3 py-1 rounded-full bg-cardbg border border-white/10 text-xs font-bold text-muted">
                ${cart.reduce((s, i) => s + i.quantity, 0)} Items
              </span>
            </div>

            ${
              cart.length === 0
                ? `
              <div class="bg-cardbg border border-white/10 rounded-3xl p-12 text-center my-8">
                <div class="w-16 h-16 rounded-2xl bg-obsidian border border-white/10 flex items-center justify-center mx-auto mb-4 text-fire">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                    <path d="M3 6h18"></path>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </div>
                <h2 class="font-display font-extrabold text-xl text-white">Your Bag Is Empty</h2>
                <p class="text-xs sm:text-sm text-muted mt-2 max-w-sm mx-auto">
                  Explore i.Box18 heavyweight hoodies, tactical cargos, tailored trousers, and luxury footwear.
                </p>
                <button onclick="App.navigate('category', { category: 'All' })" class="mt-6 px-7 py-3.5 rounded-xl fire-gradient-hover font-display font-extrabold text-xs uppercase tracking-widest text-white">
                  Explore Menswear
                </button>
              </div>
            `
                : `
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <!-- Cart Items List -->
                <div class="lg:col-span-7 space-y-3.5">
                  ${cart
                    .map(
                      item => `
                    <div class="bg-cardbg border border-white/10 rounded-2xl p-3.5 sm:p-4 flex gap-3.5 sm:gap-4 items-center">
                      <img onclick="App.navigate('product', { productId: '${item.productId}' })" src="${UI.escapeHTML(item.image)}" onerror="this.src='${UI.fallbackImg(item.name)}'" alt="${UI.escapeHTML(item.name)}" class="w-20 h-24 sm:w-24 sm:h-28 rounded-xl object-cover bg-obsidian cursor-pointer shrink-0" />
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2">
                          <h3 onclick="App.navigate('product', { productId: '${item.productId}' })" class="font-display font-bold text-sm sm:text-base text-white hover:text-fire cursor-pointer truncate">
                            ${UI.escapeHTML(item.name)}
                          </h3>
                          <button onclick="App.removeCartItem('${item.cartItemId}')" aria-label="Remove item" class="text-muted hover:text-fire p-1 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                          </button>
                        </div>

                        <div class="flex items-center gap-2 mt-1 text-xs text-muted">
                          <span class="px-2 py-0.5 rounded bg-obsidian border border-white/10 text-white font-bold">Size: ${UI.escapeHTML(item.size)}</span>
                          <span>${UI.escapeHTML(item.color)}</span>
                        </div>

                        <div class="mt-3 flex items-center justify-between">
                          <span class="font-extrabold text-sm sm:text-base text-white">${UI.formatCurrency(item.price * item.quantity)}</span>
                          <div class="inline-flex items-center bg-obsidian border border-white/10 rounded-lg">
                            <button onclick="App.updateCartItemQty('${item.cartItemId}', -1)" class="w-8 h-8 flex items-center justify-center text-white hover:text-fire font-bold">−</button>
                            <span class="w-7 text-center text-xs font-extrabold">${item.quantity}</span>
                            <button onclick="App.updateCartItemQty('${item.cartItemId}', 1)" class="w-8 h-8 flex items-center justify-center text-white hover:text-fire font-bold">+</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  `
                    )
                    .join('')}
                </div>

                <!-- Order Summary Box -->
                <div class="lg:col-span-5 bg-charcoal border border-white/10 rounded-3xl p-5 sm:p-6 sticky top-24">
                  <h2 class="font-display font-extrabold text-lg text-white mb-4">ORDER SUMMARY</h2>

                  <div class="space-y-3 text-sm pb-4 border-b border-white/10">
                    <div class="flex justify-between text-muted">
                      <span>Subtotal</span>
                      <span class="text-white font-semibold">${UI.formatCurrency(totals.subtotal)}</span>
                    </div>
                    <div class="flex justify-between text-muted">
                      <span>Delivery Charge</span>
                      <span class="${totals.delivery === 0 ? 'text-emerald-400 font-bold' : 'text-white font-semibold'}">
                        ${totals.delivery === 0 ? 'FREE' : UI.formatCurrency(totals.delivery)}
                      </span>
                    </div>
                    ${
                      totals.delivery > 0
                        ? `<p class="text-[11px] text-ember">Add ${UI.formatCurrency(totals.threshold - totals.subtotal)} more for Free Express Delivery.</p>`
                        : `<p class="text-[11px] text-emerald-400">Unlocked Free Priority Shipping!</p>`
                    }
                  </div>

                  <div class="flex justify-between items-baseline py-4">
                    <span class="font-display font-bold text-base text-white">Grand Total</span>
                    <span class="font-display font-extrabold text-2xl text-white">${UI.formatCurrency(totals.total)}</span>
                  </div>

                  <button onclick="App.navigate('checkout')" class="w-full py-4 rounded-xl fire-gradient-hover font-display font-extrabold text-xs sm:text-sm uppercase tracking-widest text-white shadow-fire-glow">
