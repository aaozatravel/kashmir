        if (cart.length === 0) {
          this.navigate('cart');
          return '';
        }
        const totals = this.getCartTotals();
        const profile = this.getProfile();

        return `
          <div class="view-animate max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-16">
