      // ------------------------------------------------------------------------
      // CART, WISHLIST & ORDER ACTIONS
      // ------------------------------------------------------------------------
      updateCartBadges(animate = false) {
        const cart = this.getCart();
        const totalQty = cart.reduce((sum, item) => sum + (Number(item.quantity) || 1), 0);
        ['header-cart-badge', 'bottom-cart-badge'].forEach(id => {
          const el = document.getElementById(id);
          if (el) {
            el.textContent = totalQty;
            if (animate) {
              el.classList.remove('badge-pop');
              void el.offsetWidth;
              el.classList.add('badge-pop');
            }
          }
        });
      },

      toggleWishlist(productId, event) {
        if (event) event.stopPropagation();
        let wishlist = this.getWishlist();
        const exists = wishlist.includes(productId);
        if (exists) {
          wishlist = wishlist.filter(id => id !== productId);
          UI.toast('Removed from Wishlist.', 'warning');
        } else {
          wishlist.push(productId);
          UI.toast('Saved to Wishlist!', 'success');
        }
        Store.set(STORAGE_KEYS.WISHLIST, wishlist);
        this.renderView();
      },

      quickAddToCart(productId, event) {
        if (event) event.stopPropagation();
        const product = this.getProducts().find(p => p.id === productId);
        if (!product || !product.available || product.stock <= 0) {
          UI.toast('This item is currently out of stock.', 'error');
          return;
        }
        // Open PDP so user selects required size explicitly, or if only 1 size exists add directly
        if (product.sizes && product.sizes.length === 1) {
          this.addToCart(product.id, product.sizes[0], product.colors?.[0] || 'Standard', 1);
        } else {
          UI.toast('Select your size to add to bag.', 'warning');
          this.navigate('product', { productId: product.id });
        }
      },

      addToCart(productId, size, color, quantity = 1, redirectCheckout = false) {
        const product = this.getProducts().find(p => p.id === productId);
        if (!product) return;

        if (!size) {
          UI.toast('Please select a size first.', 'error');
          const sizeBox = document.getElementById('pdp-size-selector');
          if (sizeBox) {
            sizeBox.classList.add('shake-anim', 'border-fire');
            setTimeout(() => sizeBox.classList.remove('shake-anim', 'border-fire'), 500);
          }
          return;
        }

        const cart = this.getCart();
        const existingIndex = cart.findIndex(
          item => item.productId === productId && item.size === size && item.color === color
        );

        if (existingIndex > -1) {
          cart[existingIndex].quantity += Number(quantity);
        } else {
          cart.push({
            cartItemId: 'CRT-' + Date.now() + '-' + Math.floor(Math.random() * 999),
            productId: product.id,
            name: product.name,
            price: Number(product.price),
            image: product.images?.[0] || UI.fallbackImg(product.name),
            size,
            color: color || 'Obsidian',
            quantity: Number(quantity)
          });
        }

        Store.set(STORAGE_KEYS.CART, cart);
        this.updateCartBadges(true);

        if (redirectCheckout) {
          this.navigate('checkout');
        } else {
          UI.toast(`${product.name} (${size}) added to bag!`, 'success');
        }
      },

      updateCartItemQty(cartItemId, delta) {
        let cart = this.getCart();
        const idx = cart.findIndex(i => i.cartItemId === cartItemId);
        if (idx === -1) return;

        cart[idx].quantity += delta;
        if (cart[idx].quantity <= 0) {
          cart.splice(idx, 1);
          UI.toast('Item removed from bag.', 'warning');
        }
        Store.set(STORAGE_KEYS.CART, cart);
        this.updateCartBadges(true);
        this.renderView();
      },

      removeCartItem(cartItemId) {
        const cart = this.getCart().filter(i => i.cartItemId !== cartItemId);
        Store.set(STORAGE_KEYS.CART, cart);
        this.updateCartBadges(true);
        UI.toast('Item removed from bag.', 'warning');
        this.renderView();
      },

      getCartTotals() {
        const cart = this.getCart();
        const settings = this.getAdminSettings();
        const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
        const threshold = Number(settings.freeShippingThreshold) || 1999;
        const standardFee = Number(settings.standardShippingFee) || 99;
        const delivery = subtotal === 0 ? 0 : subtotal >= threshold ? 0 : standardFee;
        return {
          subtotal,
          delivery,
          total: subtotal + delivery,
          threshold
        };
      },

